<UserControl x:Class="Akara.Desktop.WorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Akara.Desktop.Controls" xmlns:vm="clr-namespace:Akara.Desktop.ViewModels"
 Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13" Background="{StaticResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" DataContextChanged="OnDataContextChanged" SizeChanged="OnSizeChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/><controls:InverseVisibilityConverter x:Key="NotVis"/><controls:SectionVisibilityConverter x:Key="SectionVis"/><controls:ItemImageConverter x:Key="ItemImage"/><controls:BrushConverter x:Key="ColorBrush"/><controls:ClassSigilConverter x:Key="ClassSigil"/><controls:SelectionMatchConverter x:Key="SelectionMatch"/>
  <Style x:Key="Section" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="24,14,24,24"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}"><Setter Property="Margin" Value="0,14,0,6"/></Style>
  <Style x:Key="StorageTab" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,4,0"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/><Binding Path="DataContext.SelectedStorage" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></DataTrigger.Binding><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="#78603E"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Background" Value="#181D1B"/></DataTrigger></Style.Triggers></Style><Style x:Key="WeaponTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SelectionMatch}"><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/><Binding Path="DataContext.SelectedWeaponSet" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></DataTrigger.Binding><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#29271C"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="ItemRow"><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Converter={StaticResource ItemImage}}" Width="32" Height="42"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{Binding Accent,Converter={StaticResource ColorBrush}}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LocationLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></Grid></DataTemplate>
 </UserControl.Resources>
 <UserControl.InputBindings>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/><KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding PreviewCommand}"/>
 </UserControl.InputBindings>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition x:Name="LeadingGutter" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="314"/><ColumnDefinition x:Name="TrailingGutter" Width="0"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <!-- Native title bar; the same visual tree is used by the offscreen renderer. -->
  <Border Grid.ColumnSpan="5" Background="#0A0C0D" MouseLeftButtonDown="OnTitleDrag"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimizar"/><Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximizar o restaurar"/><Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Cerrar AKARA"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="AKARA" Foreground="#777C74" FontSize="10" Margin="18,0" VerticalAlignment="Center"/><TextBlock Text="{Binding DemoLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsSyntheticDemo,Converter={StaticResource BoolVis}}"/></StackPanel></DockPanel></Border>
  <!-- The left rail has a quiet, permanent identity, not dashboard cards. -->
  <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Background="#101314" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="*"/><RowDefinition Height="173"/></Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
     <Grid Width="80" Height="83"><Image Source="{x:Static controls:BrandArt.Logo}" Stretch="Uniform"/></Grid>
     <TextBlock Text="A K A R A" FontFamily="Georgia" FontSize="25" Foreground="#E7DFC9" HorizontalAlignment="Center" Margin="0,11,0,0" AutomationProperties.Name="AKARA"/>
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedValuePath="Key" SelectedValue="{Binding SelectedView,Mode=TwoWay}" Padding="0,4" VerticalAlignment="Top">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="23,15"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Georgia" FontSize="16" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="17,8,17,17"><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14"/><TextBlock Text="PERSONAJES LOCALES" Style="{StaticResource Eyebrow}"/><ComboBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" DisplayMemberPath="Name" Margin="0,3,0,9"/><Button Content="Abrir otra partida" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left"/><TextBlock Text="{Binding ProfileLabel}" Foreground="#6E766F" FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <!-- Character heading. -->
  <Grid Grid.Row="1" Grid.Column="2" Margin="25,7,24,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="60" Height="70" BorderBrush="#6D5E40" BorderThickness="1" Background="#1E221E" VerticalAlignment="Center"><Image Source="{Binding ClassName,Converter={StaticResource ClassSigil}}" Width="43" Height="47"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding CharacterName,FallbackValue=AKARA}" FontFamily="Georgia" FontSize="31" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding ClassLabel}" FontFamily="Georgia" FontSize="16" Foreground="#CFC8B7"/><TextBlock Text=" │ " Foreground="#6F654D" Margin="9,0"/><TextBlock Text="{Binding LevelText,StringFormat=Nivel {0}}" FontFamily="Georgia" FontSize="16" Foreground="#CFC8B7"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Nuevo" Command="{Binding CreateCommand}" Style="{StaticResource QuietButton}"/><Button Content="Clonar" Command="{Binding CloneCommand}" Style="{StaticResource QuietButton}"/></StackPanel>
   <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" BorderBrush="#75623F" BorderThickness="0,0,0,1"/>
  </Grid>
  <!-- Work surface. -->
  <Grid Grid.Row="2" Grid.Column="2">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasCharacter,Converter={StaticResource BoolVis}}">
    <Grid>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=equipment}">
      <DockPanel Margin="0,0,0,15"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="I" Width="49" Style="{StaticResource WeaponTab}" Command="{Binding SelectWeaponSetCommand}" CommandParameter="1"/><Button Content="II" Width="49" Style="{StaticResource WeaponTab}" Margin="5,0,0,0" Command="{Binding SelectWeaponSetCommand}" CommandParameter="2"/></StackPanel><TextBlock Text="Equipo" FontFamily="Georgia" FontSize="27" VerticalAlignment="Center"/><TextBlock Text="{Binding SelectedWeaponSet,StringFormat=Conjunto {0}}" Foreground="{StaticResource MutedBrush}" Margin="18,5,0,0" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel Orientation="Horizontal">
       <Border Width="454" Margin="0,0,16,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B1E1C" Offset="0"/><GradientStop Color="#111616" Offset=".45"/><GradientStop Color="#171A17" Offset="1"/></LinearGradientBrush></Border.Background><controls:PaperDoll x:Name="EquipmentDoll" Width="440" Height="500" ItemsSource="{Binding EquipmentSlots}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" ItemInvoked="OnItemInvoked"/></Border>
       <StackPanel Width="412" Margin="0,0,0,20">
        <TextBlock Text="{Binding StorageLabel}" FontFamily="Georgia" FontSize="23" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="-10,0,0,10"><Button Style="{StaticResource StorageTab}" Content="Inventario" Command="{Binding SelectStorageCommand}" CommandParameter="inventory"/><Button Style="{StaticResource StorageTab}" Content="Alijo" Command="{Binding SelectStorageCommand}" CommandParameter="stash"/><Button Style="{StaticResource StorageTab}" Content="Cubo" Command="{Binding SelectStorageCommand}" CommandParameter="cube"/><Button Style="{StaticResource StorageTab}" Content="Cinturón" Command="{Binding SelectStorageCommand}" CommandParameter="belt"/></StackPanel>
        <Border BorderBrush="#6C5D3D" BorderThickness="1" Background="#090C0D" Padding="5" HorizontalAlignment="Left"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="400" MaxHeight="560"><controls:InventoryBoard x:Name="InventoryCells" ItemsSource="{Binding VisibleInventory}" Columns="{Binding GridColumns}" Rows="{Binding GridRows}" CellSize="40" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" ItemInvoked="OnItemInvoked"/></Viewbox></Border>
        <TextBlock Text="Selecciona una pieza para examinarla. Doble clic para editar." Style="{StaticResource Muted}" FontSize="12" Margin="0,15,0,12"/>
        <WrapPanel><Button Content="Mover objeto" Command="{Binding MoveItemCommand}" Margin="0,0,8,8"/><Button Content="Importar objeto" Command="{Binding ImportBlueprintCommand}" Margin="0,0,0,8"/></WrapPanel>
        <Button Content="Rellenar tomos y pociones" Command="{Binding FillSuppliesCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
       </StackPanel>
      </WrapPanel>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Usar este conjunto al cargar" Command="{Binding ActivateWeaponSetCommand}" CommandParameter="{Binding SelectedWeaponSet}"/><TextBlock Text="{Binding ActiveWeaponSet,StringFormat=Conjunto activo en la partida: {0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel></Border>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=character}">
      <TextBlock Text="Tu personaje" Style="{StaticResource SectionTitle}"/><TextBlock Text="Atributos, experiencia y recursos base." Style="{StaticResource Muted}"/>
      <Grid Margin="0,22,0,0" IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CharacterName,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nivel" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LevelText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Experiencia" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ExperienceText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Oro encima" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding GoldText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Oro del alijo" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StashGoldText,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Fuerza" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StrengthText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Destreza" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DexterityText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Vitalidad" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding VitalityText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Energía" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EnergyText,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding AttributePointsText}" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0"/></StackPanel>
      </Grid>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,25,0,18"/>
      <UniformGrid Columns="2"><StackPanel><TextBlock Text="VIDA BASE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BaseLifeText}" FontFamily="Georgia" FontSize="27"/></StackPanel><StackPanel><TextBlock Text="MANÁ BASE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BaseManaText}" FontFamily="Georgia" FontSize="27" Foreground="{StaticResource BlueBrush}"/></StackPanel></UniformGrid>
      <TextBlock Text="El juego aplica las bonificaciones del equipo al cargar la partida." Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12"/>
      <TextBlock Text="Perfil de datos" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/><Button Content="Añadir otra carpeta de datos" Click="OnAddProfile" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=skills}">
      <DockPanel><TextBlock Text="Habilidades" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SkillPointsText}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></DockPanel>
      <ItemsControl ItemsSource="{Binding Skills}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#35372E" BorderThickness="0,0,0,1" Margin="0,0,14,16" Padding="0,8,0,15"><StackPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="17" TextWrapping="Wrap" MinHeight="42"/><TextBlock Text="{Binding Requirement}" Foreground="{StaticResource MutedBrush}" FontSize="10"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Content="−" Padding="0,6" Command="{Binding DataContext.DecreaseSkillCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBox Grid.Column="1" Text="{Binding Points,UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" FontFamily="Georgia" FontSize="20"/><Button Grid.Column="2" Content="+" Padding="0,6" Command="{Binding DataContext.IncreaseSkillCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=mercenary}">
      <DockPanel><StackPanel><TextBlock Text="{Binding MercenaryName}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding MercenaryLevelText}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding MercenaryAura}" Foreground="{StaticResource AccentBrush}" Margin="0,5"/></StackPanel><Button Content="Cambiar mercenario" IsEnabled="{Binding CanEdit}" Click="OnMercenary" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#111516" Margin="0,15,0,10"><controls:PaperDoll Height="530" ItemsSource="{Binding MercenarySlots}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}" ItemInvoked="OnItemInvoked"/></Border>
      <TextBlock Text="Un arma de dos manos reserva la mano secundaria. Selecciona una pieza para moverla o editarla." Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=world}">
      <TextBlock Text="Mundo" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CurrentDifficulty}" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource AccentBrush}"/>
      <StackPanel Orientation="Horizontal" Margin="0,18,0,22"><Button Content="Desbloquear Infierno" Command="{Binding UnlockHellCommand}"/><Button Content="Todos los transportadores" Command="{Binding UnlockWaypointsCommand}" Margin="8,0,0,0"/></StackPanel>
      <TabControl><TabItem Header="Misiones"><DataGrid IsEnabled="{Binding CanEdit}" ItemsSource="{Binding WorldQuests}" MaxHeight="620"><DataGrid.Columns><DataGridTextColumn Header="Dificultad" Binding="{Binding DifficultyLabel}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Misión" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridComboBoxColumn Header="Estado" SelectedValueBinding="{Binding State,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="170"><DataGridComboBoxColumn.ElementStyle><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="ItemsSource" Value="{Binding DataContext.QuestStateChoices,RelativeSource={RelativeSource AncestorType=UserControl}}"/></Style></DataGridComboBoxColumn.ElementStyle><DataGridComboBoxColumn.EditingElementStyle><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="ItemsSource" Value="{Binding DataContext.QuestStateChoices,RelativeSource={RelativeSource AncestorType=UserControl}}"/></Style></DataGridComboBoxColumn.EditingElementStyle></DataGridComboBoxColumn></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Transportadores"><DataGrid IsEnabled="{Binding CanEdit}" ItemsSource="{Binding WorldWaypoints}" MaxHeight="620"><DataGrid.Columns><DataGridTextColumn Header="Dificultad" Binding="{Binding DifficultyLabel}" IsReadOnly="True" Width="95"/><DataGridTextColumn Header="Destino" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active,UpdateSourceTrigger=PropertyChanged}" Width="70"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=workshop}">
      <TextBlock Text="El taller" Style="{StaticResource SectionTitle}"/><TextBlock Text="Crea una pieza propia o encuentra un objeto en los datos de tu instalación." Style="{StaticResource Muted}"/>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,24"><Button Content="Crear un objeto" Command="{Binding NewItemCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Importar objeto" Command="{Binding ImportBlueprintCommand}" Margin="8,0,0,0"/></StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox SelectedValue="{Binding CatalogType}" SelectedValuePath="Tag"><ComboBoxItem Content="Únicos" Tag="unique" IsSelected="True"/><ComboBoxItem Content="Conjuntos" Tag="set"/><ComboBoxItem Content="Palabras rúnicas" Tag="runeword"/><ComboBoxItem Content="Bases" Tag="base"/></ComboBox><TextBox Grid.Column="1" Text="{Binding CatalogQuery,UpdateSourceTrigger=PropertyChanged}" Margin="9,0"/><Button Grid.Column="2" Content="Buscar" Command="{Binding SearchCatalogCommand}"/></Grid>
      <ListBox ItemsSource="{Binding CatalogEntries}" SelectedItem="{Binding SelectedCatalogEntry}" MaxHeight="440" Margin="0,12,0,12"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="17"/><TextBlock Text="{Binding Code}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding LevelRequired,StringFormat=Nivel {0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Button Content="Añadir al alijo" Command="{Binding AddCatalogItemCommand}" HorizontalAlignment="Right"/>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=library}">
      <TextBlock Text="Biblioteca" Style="{StaticResource SectionTitle}"/><TextBlock Text="Configuraciones para volver a jugar a tu manera." Style="{StaticResource Muted}"/>
      <TextBlock Text="Plantillas de Reimagined" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"/><TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource Muted}" Margin="0,10,0,12"/><Button Content="Preparar plantilla" Command="{Binding ApplyPresetCommand}" HorizontalAlignment="Left"/><Expander IsExpanded="True" Header="Cómo jugar esta plantilla" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}"><TextBlock Text="{Binding SelectedPresetGuide}" TextWrapping="Wrap" Foreground="#B7BCAE" LineHeight="21" MaxWidth="880" HorizontalAlignment="Left"/></Expander>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,18"/><TextBlock Text="Tus configuraciones" FontFamily="Georgia" FontSize="22"/>
      <ListBox ItemsSource="{Binding Loadouts}" SelectedItem="{Binding SelectedLoadout}" MaxHeight="210" Margin="0,12"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="16"/><TextBlock Text="{Binding ItemCount,StringFormat={}{0} piezas}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <CheckBox Content="Incluir nivel, atributos y habilidades" IsChecked="{Binding LoadoutIncludeCharacter}"/><CheckBox Content="Conservar las piezas anteriores en el alijo" IsChecked="{Binding LoadoutKeepPrevious}"/>
      <StackPanel Orientation="Horizontal"><Button Content="Preparar configuración" Command="{Binding ApplyLoadoutCommand}"/><Button Content="Eliminar" Command="{Binding DeleteLoadoutCommand}" Style="{StaticResource QuietButton}" Margin="9,0"/></StackPanel>
      <TextBlock Text="Guardar la configuración actual" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding LoadoutName,UpdateSourceTrigger=PropertyChanged}"/><WrapPanel Margin="0,12,0,0"><Button Content="Guardar en biblioteca" Command="{Binding SaveLoadoutCommand}" Margin="0,0,7,7"/><Button Content="Exportar" Command="{Binding ExportLoadoutCommand}" Margin="0,0,7,7"/><Button Content="Importar" Command="{Binding ImportLoadoutCommand}" Margin="0,0,7,7"/></WrapPanel>
     </StackPanel>
     <StackPanel Style="{StaticResource Section}" Visibility="{Binding SelectedView,Converter={StaticResource SectionVis},ConverterParameter=changes}">
      <DockPanel><Button DockPanel.Dock="Right" Content="Descartar borrador" ToolTip="Vuelve a la partida abierta y descarta todos los cambios del borrador." Command="{Binding ResetCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Top"/><TextBlock Text="Revisar los cambios" Style="{StaticResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <ItemsControl ItemsSource="{Binding Changes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource FaintBorderBrush}" BorderThickness="0,0,0,1" Padding="0,13"><StackPanel><TextBlock Text="{Binding Label}" FontFamily="Georgia" FontSize="17"/><TextBlock Text="{Binding Before}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,3"/><TextBlock Text="{Binding After}" Foreground="#B7C29A" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,18"/><DockPanel><TextBlock Text="Copias de seguridad" FontFamily="Georgia" FontSize="22"/><Button Content="Actualizar" Command="{Binding RefreshBackupsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></DockPanel><ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="150" DisplayMemberPath="DisplayDate"/><Button Content="Restaurar copia elegida" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Visibility="{Binding HasCharacter,Converter={StaticResource NotVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="40"><TextBlock Text="Elige tu personaje" FontFamily="Georgia" FontSize="36" HorizontalAlignment="Center"/><TextBlock Text="Abre una partida local o empieza una nueva historia." Style="{StaticResource Muted}" TextAlignment="Center" FontSize="15" Margin="0,17,0,26"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Abrir partida" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Nuevo personaje" Command="{Binding CreateCommand}" Margin="10,0,0,0"/></StackPanel></StackPanel>
  </Grid>
  <!-- Inspector. Text and item statistics remain native, selectable data. -->
  <Border Grid.Column="3" Grid.Row="1" Grid.RowSpan="2" Margin="0,12,16,15" BorderBrush="#655B42" BorderThickness="1" Background="#0B0E10">
   <ScrollViewer Padding="23,17,23,22"><StackPanel>
    <TextBlock Text="{Binding SelectedItem.LocationLabel}" Style="{StaticResource Eyebrow}"/>
    <Image Source="{Binding SelectedItem,Converter={StaticResource ItemImage}}" Height="250" Stretch="Uniform" Margin="14,12,14,15"/>
    <TextBlock Text="{Binding SelectedItem.Name}" FontFamily="Georgia" FontSize="28" Foreground="{Binding SelectedItem.Accent,Converter={StaticResource ColorBrush}}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedItem.DetailLine}" Foreground="{StaticResource MutedBrush}" Margin="0,11,0,7" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedItem.BaseName}" Foreground="#ABAE9F" FontSize="12" TextWrapping="Wrap"/>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,17,0,16"/>
    <ItemsControl ItemsSource="{Binding SelectedItem.VisibleStats}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{StaticResource BlueBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Hidden}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,15,0,16"/>
    <UniformGrid Columns="2" Visibility="{Binding HasSelectedItem,Converter={StaticResource BoolVis}}"><Button Content="Editar" Command="{Binding DesignItemCommand}" Margin="0,0,5,6"/><Button Content="Mover" Command="{Binding MoveItemCommand}" Margin="5,0,0,6"/><Button Content="Duplicar" Command="{Binding CopyItemCommand}" Margin="0,0,5,6"/><Button Content="Eliminar" Command="{Binding DeleteItemCommand}" Margin="5,0,0,6"/></UniformGrid>
    <Button Content="Exportar objeto" Command="{Binding ExportBlueprintCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Visibility="{Binding HasSelectedItem,Converter={StaticResource BoolVis}}"/>
    <TextBlock Text="Selecciona una pieza del equipo o del inventario para examinarla." Style="{StaticResource Muted}" Visibility="{Binding HasSelectedItem,Converter={StaticResource NotVis}}"/>
   </StackPanel></ScrollViewer>
  </Border>
  <!-- Persistent review/save controls. -->
  <Border Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Background="#111514" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="23,10,16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,15,3"/><TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MaxHeight="30" Visibility="{Binding HasErrors,Converter={StaticResource BoolVis}}"/><ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="Transparent" Margin="0,4,25,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↶" Command="{Binding UndoCommand}" ToolTip="Deshacer · Ctrl+Z" FontSize="21" Padding="12,5"/><Button Content="↷" Command="{Binding RedoCommand}" ToolTip="Rehacer · Ctrl+Y" FontSize="21" Padding="12,5" Margin="5,0,12,0"/><Button Content="Exportar copia" Command="{Binding ExportCommand}" Margin="0,0,8,0"/><Button Content="Revisar cambios" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/><Button Content="Guardar con copia" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Border>
 </Grid>
</UserControl>
